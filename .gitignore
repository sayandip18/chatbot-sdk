# ==============================================================================
# 1. MONOREPO ROOT & PACKAGE MANAGERS
# ==============================================================================
node_modules/
.pnpm-store/
.turbo/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# 2. APPS: FRONTEND (React / Vite / Next.js)
# ==============================================================================
# Production build outputs
apps/web/dist/
apps/web/build/
apps/web/.next/

# Vite / Next cache
.vite/
.next/
*.tsbuildinfo

# Coverage directories (if running tests)
apps/web/coverage/

# ==============================================================================
# 3. APPS: BACKEND (NestJS)
# ==============================================================================
# NestJS compilation output
apps/api/dist/

# TypeScript build cache
apps/api/*.tsbuildinfo

# SWC or structural build artifacts
apps/api/.swc/

# ==============================================================================
# 4. SECURITY & ENVIRONMENT VARIABLES (NEVER COMMIT THESE)
# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==============================================================================
# 5. OS & IDE SPECIFIC
# ==============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?